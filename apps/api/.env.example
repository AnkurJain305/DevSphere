APP_ENV=local
LOG_LEVEL=INFO

# Supabase session connection, port 5432. Do not use the transaction pooler on port 6543.
# Copy this file to .env and replace the bracketed parts. URL-encode any reserved characters in the password.
# Send .env to a collaborator through a password manager, never through git.
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
